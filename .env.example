# Copy to .env and fill in only what you use. One LLM key is enough.

# LLM providers (the model name prefix picks the provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
LLAMA_API_KEY=
QWEN_API_KEY=
# Any OpenAI-compatible endpoint (vLLM, Ollama, OpenRouter)
CUSTOM_API_URL=
CUSTOM_API_KEY=

MODEL_NAME=gpt-4o-mini
TEMPERATURE=0.7
MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT=120

# Cost controls
TASK_ANALYSIS_MAX_REFINEMENT_ROUNDS=2
METHOD_DESIGN_MAX_ROUNDS=6
METHOD_DESIGN_MAX_EXPERTS=4
METHOD_DESIGN_MAX_TOKENS_PER_CALL=900

# Literature retrieval
CELLFORGE_LITERATURE_DIR=./data/literature
CELLFORGE_ONLINE_RETRIEVAL=true
PUBMED_API_KEY=
PUBMED_EMAIL=
PUBMED_TOOL=cellforge
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_EMAIL=

# Code generation (Codex CLI). Empty CODEX_MODEL uses the CLI default.
CODEGEN_BACKEND=codex
CODEX_MODEL=
CODEX_CLI_BIN=codex
# local: use `codex login` and strip provider keys; api: use CODEX_API_KEY
CODEX_AUTH_MODE=local
CODEX_API_KEY=
CODEX_PASS_OPENAI_ENV=false
CODEGEN_MAX_REPAIR_ROUNDS=5

# Runtime paths
CELLFORGE_WORKSPACE_DIR=.
CELLFORGE_CONFIG=config.json
